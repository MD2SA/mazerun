# Copy this file to `mysql/persistence/.env` when running the persistence
# service outside Docker. Inside Docker, Compose supplies these variables.
# Never commit `.env`.

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=mazerun

CONSULTING_DB_HOST=consulting-db.example.edu
CONSULTING_DB_USER=
CONSULTING_DB_PASSWORD=
CONSULTING_DB_NAME=maze

MQTT_BROKER=broker.hivemq.com
