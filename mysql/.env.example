# Copy this file to `mysql/.env`. Docker Compose reads it for variable substitution.
# Never commit `.env`.

# Local MySQL container and application credentials.
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=mazerun

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# MQTT broker and simulator launch defaults used by the PHP API.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MAZERUN_DELAY=2
MAZERUN_EXE_PATH=/game/server/mazerun.exe

# Read-only consulting MySQL used by the persistence service and score watcher.
CONSULTING_DB_HOST=consulting-db.example.edu
CONSULTING_DB_USER=
CONSULTING_DB_PASSWORD=
CONSULTING_DB_NAME=maze
