# Copy this file to `mongo/.env` and fill in the values.
# Never commit `.env`.

# MongoDB connection string. Docker Compose overrides this with the replica-set URI.
MONGO_URI=mongodb://localhost:27017

# MQTT broker used by the inbound/outbound services.
MQTT_BROKER=broker.hivemq.com

# Read-only consulting MySQL used to fetch simulation configuration.
# Leave the user/password empty if you are not using it.
CONSULTING_DB_HOST=consulting-db.example.edu
CONSULTING_DB_USER=
CONSULTING_DB_PASSWORD=
CONSULTING_DB_NAME=maze
